{
  "name": "portfolio-v3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "node .output/server/index.mjs",
    "build": "npm run sync:events && npm run sync:galleries && vite build",
    "sync:events": "node scripts/sync-luma-events.mjs",
    "sync:galleries": "node scripts/sync-event-galleries.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:studio": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit studio",
    "serve": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "npx tsc --noEmit"
  },
